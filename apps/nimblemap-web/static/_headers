# Cloudflare Pages (and Netlify) response headers for the NimbleMap web app (docs/lm/web-app.md).
# The app is single-threaded WebAssembly: no Cross-Origin-Opener/Embedder-Policy is needed (adding
# COEP: require-corp would block the basemap's cross-origin tiles).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/nimblemap-*.js
  Cache-Control: public, max-age=31536000, immutable

/examples/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=2592000

/geonames/*
  Cache-Control: public, max-age=2592000
