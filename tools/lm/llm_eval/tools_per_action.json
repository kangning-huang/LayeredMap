       "field": {
        "type": "string"
       },
       "value": {
        "type": "string"
       }
      },
      "required": [
       "layer"
      ],
      "description": "one object only (optional)"
     },
     "distance": {
      "type": "string",
      "description": "e.g. '500 m', '2 km', '3 mi'"
     },
     "merge": {
      "type": "boolean",
      "description": "merge overlaps (default true)"
     }
    },
    "required": [
     "layer",
     "distance"
    ]
