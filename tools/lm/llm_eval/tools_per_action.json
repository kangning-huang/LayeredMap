 {
  "type": "function",
  "function": {
   "name": "filter",
   "description": "Show only a layer's objects meeting all conditions (replaces its filter; [] clears). Later actions use only shown objects.",
   "parameters": {
    "type": "object",
    "properties": {
     "layer": {
      "type": "string"
     },
     "conditions": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "field": {
         "type": "string"
        },
        "op": {
         "type": "string",
         "enum": [
          "is",
          "is_not",
          "contains",
          "is_empty",
          "above",
          "below",
          "between",
          "before",
          "after",
          "any_of"
         ]
        },
        "value": {
         "type": "string",
         "description": "number or text"
        },
        "value2": {
         "type": "string",
         "description": "upper end for between"
        },
        "values": {
         "type": "array",
         "items": {
          "type": "string"
         },
         "description": "for any_of"
        }
       },
       "required": [
        "field",
        "op"
       ]
      }
     }
    },
    "required": [
     "layer",
     "conditions"
    ]
   }
  }
 },
